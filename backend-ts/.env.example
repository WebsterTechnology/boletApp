# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change-me

# Optional
PORT=8000
# Set to "false" to connect without SSL (e.g. a local Postgres). Defaults to SSL on, like ../backend.
DB_SSL=true
# Comma-separated list of allowed browser origins. Defaults to "*" (same as ../backend).
CORS_ORIGINS=*

# Asaas (PIX)
ASAAS_API_KEY=
ASAAS_BASE_URL=
ASAAS_ENV=sandbox

# InfinitePay
INFINITEPAY_HANDLE=laurius-debrune
